{
  "name": "SC16IS7XX",
  "version": "2.0.0",
  "description": "Arduino Library for SC16IS752 and SC16IS762 I2C and SPI UART interfaces.",
  "keywords": "EnviroDIY, SC16IS7XX, I2C, SPI, UART, SC16IS752, SC16IS762",
  "platforms": "*",
  "frameworks": "arduino",
  "authors": [
    {
      "name": "Sara Damiano",
      "email": "sdamiano@stroudcenter.org",
      "url": "https://envirodiy.org/",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EnviroDIY/SC16IS7XX.git"
  },
  "export": {
    "include": [
      "LICENSE.md",
      "library.json",
      "library.properties",
      "README.md",
      "src/*",
      "examples/*"
    ]
  },
  "examples": ["examples/*/*.ino"],
  "build": {
    "srcFilter": ["+<*.c>", "+<*.cpp>", "+<*.h>"],
    "libLDFMode": "deep+"
  },
  "dependencies": [
    {
      "name": "Adafruit BusIO",
      "owner": "adafruit",
      "library id": "6214",
      "url": "https://github.com/adafruit/Adafruit_BusIO",
      "version": "~1.17.4",
      "note": "Adafruit BusIO, a dependency of other Adafruit libraries",
      "authors": ["Adafruit"],
      "frameworks": "arduino"
    }
  ]
}
